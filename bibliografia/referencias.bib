
% ============================================================
% BASE BIBLIOGRÁFICA DEL CURSO
%
% Cada referencia utiliza una clave única.
%
% Ejemplo:
%
% @book{apellido2026,
%   author    = {Apellido, Nombre},
%   title     = {Título de la obra},
%   year      = {2026},
%   publisher = {Editorial},
%   keywords  = {base}
% }
%
% Las líneas de ejemplo están comentadas con %, por lo que no
% aparecerán en la bibliografía hasta retirar esos signos.
% ============================================================

% Esta entrada evita errores de Biber mientras la base
% bibliográfica real todavía está vacía.
%
% Estas entradas deben eliminarse al incorporar las primeras referencias reales.

@misc{referencia-pendiente,
  author = {{REFERENCIA PENDIENTE}},
  title  = {Sustituye esta entrada por la bibliografía del curso},
  year   = {2026},
  keywords  = {base}
}
@misc{referencia-suplementaria-pendiente,
  author   = {{REFERENCIA SUPLEMENTARIA PENDIENTE}},
  title    = {Sustituye esta entrada por una lectura complementaria},
  year     = {2026},
  keywords = {suplementaria}
}